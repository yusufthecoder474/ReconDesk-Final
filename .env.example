SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=recondesk
MYSQL_USER=recondesk
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=db
MYSQL_PORT=3306
MATCHER_URL=http://matcher:5000
MATCHER_SHARED_TOKEN=change-this-internal-token

# --- SaaS connector (mock server) ---
# Base URL of the external API. For local development this is the
# mock server (python -m connectors.mock_server, port 5001).
MOCK_CONNECTOR_BASE_URL=http://127.0.0.1:5001
# Auth scheme: bearer | basic | api_key
MOCK_CONNECTOR_AUTH_TYPE=bearer
# Bearer / API-key token. Never commit a real token; this value is
# the mock server's default test token only.
MOCK_CONNECTOR_API_TOKEN=mock-test-token
# Only used when MOCK_CONNECTOR_AUTH_TYPE=basic:
MOCK_CONNECTOR_USERNAME=mock
MOCK_CONNECTOR_PASSWORD=mock
MOCK_CONNECTOR_PAGE_SIZE=100
MOCK_CONNECTOR_MAX_RETRIES=3
# Token the mock server itself accepts (its own env var):
MOCK_API_TOKEN=mock-test-token
